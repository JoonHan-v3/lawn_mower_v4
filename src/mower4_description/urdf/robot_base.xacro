<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.7" />
    <xacro:property name="base_width" value="0.5" />
    <xacro:property name="base_height" value="0.2" />

    <xacro:property name="wheel_radius" value="0.12" />
    <xacro:property name="wheel_length" value="0.06" />

    <xacro:property name="deck_radius" value="0.24" />
    <xacro:property name="deck_length" value="0.08" />

    <xacro:property name="blade_length" value="0.42"/>
    <xacro:property name="blade_width" value="0.035"/>
    <xacro:property name="blade_height" value="0.008"/>

    <xacro:property name="bumper_length" value="0.08"/>
    <xacro:property name="bumper_width" value="0.54"/>
    <xacro:property name="bumper_height" value="0.09"/>

    <xacro:property name="base_z_offset" value="0.16"/>
    <xacro:property name="base_com_x_offset" value="-0.10"/>

    <xacro:property name="caster_radius" value="0.055"/>
    <xacro:property name="caster_x_offset" value="-0.27"/>

    <xacro:property name="deck_offset_x" value="0.16"/>
    <xacro:property name="deck_offset_z" value="0.055"/>

    <xacro:property name="lidar_radius" value="0.04"/>
    <xacro:property name="lidar_length" value="0.05"/>
    <xacro:property name="lidar_offset_x" value="0.20"/>
    <xacro:property name="lidar_offset_z" value="0.33"/>

    <xacro:property name="imu_offset_x" value="0.0"/>
    <xacro:property name="imu_offset_z" value="0.18"/>

    <xacro:property name="gps_radius" value="0.03"/>
    <xacro:property name="gps_length" value="0.04"/>
    <xacro:property name="gps_offset_x" value="-0.15"/>
    <xacro:property name="gps_offset_z" value="0.42"/>

    <!-- Ground reference frame -->
    <link name="base_footprint" />

    <!-- Main chassis -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0" />
            <material name="green" />
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
        </collision>

        <!-- CoM shifted rearward (battery/motor pack toward the back) to counterbalance the front-mounted deck/blade/bumper and keep the rear caster loaded -->
        <xacro:box_inertia m="18.0" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="${base_com_x_offset} 0 ${base_z_offset}" o_rpy="0 0 0" />
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!--Right Wheel-->
    <xacro:wheel_link prefix="right" />

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 ${-(base_width + wheel_length) / 2.0} ${wheel_radius}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!--Left Wheel-->
    <xacro:wheel_link prefix="left" />

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 ${(base_width + wheel_length) / 2.0} ${wheel_radius}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!--Caster Wheel-->
    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:sphere_inertia m="1.0" r="${caster_radius}"
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${caster_x_offset} 0 ${caster_radius}" rpy="0 0 0" />
    </joint>

    <!-- Mower deck -->
    <link name="mower_deck_link">
        <visual>
            <origin xyz="${deck_offset_x} 0 ${deck_offset_z}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${deck_radius}" length="${deck_length}"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>

        <collision>
            <origin xyz="${deck_offset_x} 0 ${deck_offset_z}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${deck_radius}" length="${deck_length}"/>
            </geometry>
        </collision>

        <xacro:cylinder_inertia m="3.0" r="${deck_radius}" l="${deck_length}"
                                o_xyz="${deck_offset_x} 0 ${deck_offset_z}" o_rpy="0 0 0" />
        
    </link>

    <joint name="mower_deck_joint" type="fixed">
        <parent link="base_link"/>
        <child link="mower_deck_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Rotating blade -->
    <link name="blade_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${blade_length} ${blade_width} ${blade_height}"/>
            </geometry>
            <material name="silver"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${blade_length} ${blade_width} ${blade_height}"/>
            </geometry>
        </collision>

        <xacro:box_inertia m="0.8" x="${blade_length}" y="${blade_width}" z="${blade_height}" 
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="blade_joint" type="continuous">
        <parent link="mower_deck_link"/>
        <child link="blade_link"/>
        <origin xyz="${deck_offset_x} 0 0.015" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- Simple front bumper -->
    <link name="front_bumper_link">
        <visual>
            <geometry>
                <box size="${bumper_length} ${bumper_width} ${bumper_height}"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>

        <collision>
            <geometry>
                <box size="${bumper_length} ${bumper_width} ${bumper_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="1.0" x="${bumper_length}" y="${bumper_width}" z="${bumper_height}" 
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    
    </link>

    <joint name="front_bumper_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_bumper_link"/>
        <origin xyz="0.39 0 0.15" rpy="0 0 0"/>
    </joint>

    <!-- Lidar for costmap obstacle detection -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
        </collision>

        <xacro:cylinder_inertia m="0.15" r="${lidar_radius}" l="${lidar_length}"
                                o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="${lidar_offset_x} 0 ${lidar_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- IMU — gives an absolute, world-referenced yaw so navsat_transform_node
        and the global EKF can align GPS with the robot's heading -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.02"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.03 0.03 0.02"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.02"
                        o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="${imu_offset_x} 0 ${imu_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- GPS antenna, mounted clear of the chassis for an open sky view -->
    <link name="gps_link">
        <visual>
            <geometry>
                <cylinder radius="${gps_radius}" length="${gps_length}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${gps_radius}" length="${gps_length}"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.05" r="${gps_radius}" l="${gps_length}"
                                o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="gps_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps_link"/>
        <origin xyz="${gps_offset_x} 0 ${gps_offset_z}" rpy="0 0 0"/>
    </joint>

</robot>