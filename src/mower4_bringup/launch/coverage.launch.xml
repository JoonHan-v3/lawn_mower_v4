<launch>
    <node pkg="mower4_coverage" exec="boundary_loader.py">
        <param name="use_sim_time" value="true"/>
        <param name="boundary_file" value="$(find-pkg-share mower4_bringup)/config/boundary.yaml"/>
    </node>

    <node pkg="mower4_coverage" exec="coverage_planner.py">
        <param name="use_sim_time" value="true"/>
        <param name="cutting_width" value="0.42"/>
        <param name="overlap" value="0.15"/>
        <param name="boundary_inset" value="0.5"/>
        <param name="point_spacing" value="0.2"/>
    </node>

    <node pkg="mower4_coverage" exec="coverage_executor.py" output="screen">
        <param name="use_sim_time" value="true"/>
        <!-- how far ahead of the mower the planned sweep is checked against
             the global costmap; keep it inside obstacle_max_range in
             config/nav2_params.yaml or obstacles are only seen once the
             mower is already on them -->
        <param name="check_horizon" value="3.0"/>
        <!-- how far a sweep point must be from a real obstacle cell to
             count as drivable. The mower's footprint is 0.25m half-width, so
             0.40m is that plus 0.15m of margin for tracking error. Lower it
             to mow closer in, at the price of the controller refusing rows it
             judges uncrossable and the executor recovering instead of routing
             around. Measured in metres against lethal cells, so it is
             unaffected by the costmap's inflation tuning. -->
        <param name="obstacle_clearance" value="0.40"/>
        <!-- the sweep has to be clear for this far past an obstacle before
             the mower will rejoin it there. Kept short: a long run has to stay
             clear across the row end into the next row, and when the same
             obstacle blocks that one too the rejoin is pushed a whole row on,
             giving up grass the mower could have cut. -->
        <param name="clear_run" value="0.5"/>
        <param name="replan_cooldown" value="2.0"/>
        <param name="stuck_skip" value="2.0"/>
        <param name="max_recoveries" value="3"/>
    </node>
</launch>
